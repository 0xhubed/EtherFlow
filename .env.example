# EtherFlow Environment Variables
#
# 1. Copy this file to .env: cp .env.example .env
# 2. Sign up at https://www.alchemy.com/ to get your free API key
# 3. Replace the placeholder below with your actual API key in the .env file
# 4. NEVER commit your real API key to git!
#

# Alchemy API Key (Required)
# Get yours at: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Demo API Key (Optional - for public demos with usage limits)
# This should be a separate, limited API key for demo purposes only
VITE_DEMO_API_KEY=your_demo_api_key_here

# Example: VITE_ALCHEMY_API_KEY=abc123def456ghi789jkl
# Example: VITE_DEMO_API_KEY=xyz789uvw456rst123qpo

# Network (Optional, defaults to mainnet)
# Options: mainnet, goerli, sepolia, polygon, arbitrum, optimism, base
# VITE_ALCHEMY_NETWORK=mainnet
